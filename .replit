entrypoint = "README.md"
modules = ["nodejs-22", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[env]
PORT = "5000"

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081
ensurePreviewReachable = "/status"

[userenv]

[userenv.shared]
EXPO_PUBLIC_SUPABASE_URL = "https://rntdosvvitcttrshubqz.supabase.co"
REVENUECAT_APPLE_APP_ID = "appbfe187a6c1"
REVENUECAT_PROJECT_ID = "projcafd31b0"
REVENUECAT_PRO_ENTITLEMENT_ID = "entlff3f2a85d1"
REVENUECAT_TEST_APP_ID = "app746dfc07f1"

[userenv.development]
TEST_SCAN_CUSTOMER_IDS = "ss_test_a7a14bf3-d712-4274-b3f7-545ad0c6e921"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
