{
  "expo": {
    "name": "ScanProfit",
    "slug": "scanprofit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanprofit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sellerscan.pro",
      "buildNumber": "13",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan product barcodes or take photos to find shopping matches. Photos use SearchApi and Google Lens; barcode numbers use UPCitemdb."
      }
    },
    "android": {
      "package": "com.scanprofit",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product barcodes or take photos to find shopping matches. Photos use SearchApi and Google Lens; barcode numbers use UPCitemdb.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scan product barcodes or take photos to find shopping matches. Photos use SearchApi and Google Lens; barcode numbers use UPCitemdb.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-secure-store",
      ["expo-splash-screen", {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#2563EB"
      }],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
