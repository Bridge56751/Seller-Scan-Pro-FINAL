    "create-launch": "0.4.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
